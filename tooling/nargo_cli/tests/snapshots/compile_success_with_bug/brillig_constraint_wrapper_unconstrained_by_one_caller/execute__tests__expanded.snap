use std::convert::UnsafeFrom;

unconstrained fn half_helper(x: Field) -> Field {
    x / 2_Field
}

fn half_unchecked(x: Field) -> Field {
    // Safety: comment added by `nargo expand`
    unsafe {
        half_helper(x)
    }
}

fn main(a: u8, b: u8) -> pub u8 {
    let a: Field = <Field as From<u8>>::from(a);
    let b: Field = <Field as From<u8>>::from(b);
    let p: Field = half_unchecked(a);
    assert((p * 2_Field) == a);
    let q: Field = half_unchecked(b);
    u8::unsafe_from(p + q)
}
