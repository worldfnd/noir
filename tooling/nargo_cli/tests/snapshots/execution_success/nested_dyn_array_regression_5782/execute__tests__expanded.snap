fn main(mut array: [u8; 2], i: u32) {
    assert(array[i - 1_u32] == 5_u8);
    assert(array[i] == 10_u8);
    array[i] = 2_u8;
    let array2: [[u8; 2]; 2] = [array, array];
    assert(array2[0_u32][0_u32] == 5_u8);
    assert(array2[0_u32][i] == 2_u8);
    assert(array2[i][0_u32] == 5_u8);
    assert(array2[i][i] == 2_u8);
}
