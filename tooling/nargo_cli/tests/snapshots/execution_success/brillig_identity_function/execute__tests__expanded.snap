---
source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
struct myStruct {
    foo: Field,
    foo_arr: [Field; 2],
}

fn main(x: u8) {
    // Safety: comment added by `nargo expand`
    unsafe {
        assert((x as Field) == identity(x as Field));
        let arr: [Field; 2] = identity_array([x as Field, x as Field]);
        assert((x as Field) == arr[0_u32]);
        assert((x as Field) == arr[1_u32]);
        let s: myStruct = myStruct { foo: x as Field, foo_arr: [x as Field, x as Field] };
        let identity_struct: myStruct = identity_struct(s);
        assert((x as Field) == identity_struct.foo);
        assert((x as Field) == identity_struct.foo_arr[0_u32]);
        assert((x as Field) == identity_struct.foo_arr[1_u32]);
    }
}

unconstrained fn identity(x: Field) -> Field {
    std::hint::black_box(x)
}

unconstrained fn identity_array(arr: [Field; 2]) -> [Field; 2] {
    std::hint::black_box(arr)
}

unconstrained fn identity_struct(s: myStruct) -> myStruct {
    std::hint::black_box(s)
}
