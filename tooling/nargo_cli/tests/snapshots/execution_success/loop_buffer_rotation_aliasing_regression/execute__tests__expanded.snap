source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
unconstrained fn main(a: [u8; 2], c: [u8; 2]) {
    let mut a: [u8; 2] = a;
    let mut c: [u8; 2] = c;
    let mut j: u32 = 0_u32;
    while j < 2_u32 {
        j = j + 1_u32;
        c = [
            {
                let mut i: u32 = 0_u32;
                while i < 1_u32 {
                    i = i + 1_u32;
                    c[0_u32] = 99_u8;
                }
                a[0_u32]
            },
            20_u8,
        ];
        a = c;
    }
    assert(a == [1_u8, 20_u8]);
}
