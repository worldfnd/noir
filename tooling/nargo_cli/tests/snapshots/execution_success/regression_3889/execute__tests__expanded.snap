mod Foo {
    pub(crate) struct NewType {
        pub(crate) a: u8,
    }
}

mod Bar {
    pub(crate) use crate::Foo::{NewType, NewType as BarStruct};

}

mod Baz {
    pub(crate) use crate::Foo::{NewType, NewType as BarStruct};

    pub(crate) struct Works {
        pub(crate) a: u8,
    }
}

fn main(works: Baz::Works, fails: Foo::NewType, also_fails: Foo::NewType) -> pub u8 {
    (works.a + fails.a) + also_fails.a
}
