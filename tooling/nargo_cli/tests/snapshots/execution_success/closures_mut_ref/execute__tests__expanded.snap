fn main(mut x: u8) {
    let one: u8 = 1_u8;
    let add1: fn[(u8,)](&mut u8) = |z: &mut u8| { *z = *z + one; };
    let two: u8 = 2_u8;
    let add2: fn[(u8,)](&mut u8) = |z: &mut u8| { *z = *z + two; };
    add1(&mut x);
    assert(x == 1_u8);
    add2(&mut x);
    assert(x == 3_u8);
    issue_2120();
}

fn issue_2120() {
    let x1: &mut Field = &mut 42_Field;
    let set_x1: fn[(&mut Field,)](Field) = |y: Field| { *x1 = y; };
    assert(*x1 == 42_Field);
    set_x1(44_Field);
    assert(*x1 == 44_Field);
    set_x1(*x1);
    assert(*x1 == 44_Field);
}
