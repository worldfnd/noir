use std::convert::UnsafeFrom;

fn main(inp: u8) {
    let inp: Field = <Field as From<u8>>::from(inp);
    let mut x: Field = -1_Field;
    for _i in 0_u32..1_u32 {
        x = -1_Field;
    }
    let mut y: [Field; 1] = [inp / x];
    let expected: Field = <Field as From<u128>>::from(u128::unsafe_from(y[0_u32]));
    let mut actual: Field = 0_Field;
    if inp.lt(42_Field) {
        actual = <Field as From<u128>>::from(u128::unsafe_from(y[0_u32]));
    };
    assert(actual == expected);
}
