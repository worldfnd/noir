fn main(x: u8, y: u8) {
    let mut z: u8 = x + y;
    assert(z == 3_u8);
    z = x * y;
    assert(z == 2_u8);
    regression_3057();
}

fn regression_3057() {
    let mut array: [[Field; 2]; 2] = [[0_Field, 1_Field], [2_Field, 3_Field]];
    array[0_u32][1_u32] = 2_Field;
    assert(array[0_u32][1_u32] == 2_Field);
}
