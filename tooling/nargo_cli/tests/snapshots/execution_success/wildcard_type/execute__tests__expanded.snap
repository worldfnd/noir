expression: expanded_code
---
struct bar {
    enable: [bool; 4],
    data: [u8; 2],
    pad: u32,
}

fn main(enable: [u8; 2]) -> pub [u8; 4] {
    let mut result: [u8; 4] = [0_u8; 4];
    let a: [bar; 4] = foo(enable[1_u32]);
    for i in 0_u32..4_u32 {
        result[i] = a[i].data[i % 2_u32];
    }
    result
}

fn foo(x: u8) -> [bar; 4] {
    [
        bar { enable: [true, true, false, false], data: [x, x + 1_u8], pad: 0_u32 },
        bar { enable: [true, false, false, false], data: [x + 2_u8, x + 7_u8], pad: 0_u32 },
        bar { enable: [true, true, false, true], data: [x + 3_u8, x + 5_u8], pad: 0_u32 },
        bar { enable: [false, false, false, false], data: [x + 4_u8, x - 1_u8], pad: 0_u32 },
    ]
}
