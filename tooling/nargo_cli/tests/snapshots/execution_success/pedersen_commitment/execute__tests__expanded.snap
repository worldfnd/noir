expression: expanded_code
---
fn main(x: u8, y: u8, expected_x: [u8; 32], expected_y: [u8; 32]) {
    let commitment: std::embedded_curve_ops::EmbeddedCurvePoint =
        std::hash::pedersen_commitment([x as Field, y as Field]);
    assert(commitment.x.to_le_bytes() == expected_x);
    assert(commitment.y.to_le_bytes() == expected_y);
}
