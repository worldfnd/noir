unconstrained fn f(r: &mut [Field; 3], v: [Field; 3], i: u32) -> ([Field; 3], [Field; 3]) {
    (*r)[i] = 99_Field;
    (v, *r)
}

unconstrained fn main(a: u8, b: u8, c: u8, i: u32) {
    let a: Field = <Field as From<u8>>::from(a);
    let b: Field = <Field as From<u8>>::from(b);
    let c: Field = <Field as From<u8>>::from(c);
    let mut x: [Field; 3] = [a, b, c];
    let (v, r): ([Field; 3], [Field; 3]) = f(&mut x, x, i);
    assert(v[i] == a);
    assert(r[i] == 99_Field);
}
