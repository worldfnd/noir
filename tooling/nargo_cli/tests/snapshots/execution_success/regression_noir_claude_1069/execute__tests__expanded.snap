fn main(arr: [u8; 3]) {
    let c: fn[([u8; 3],)]() -> [u8; 3] = || -> [u8; 3] {
        let mut a: [u8; 3] = arr;
        a[0_u32] = 10_u8;
        let _: [u8; 3] = a;
        call(a);
        arr
    };
    let output: [u8; 3] = c();
    assert(output == [1_u8, 2_u8, 3_u8]);
}

fn call<T>(_: T) {}
