use std::convert::UnsafeFrom;

global G_A: bool = false;

fn main(a: u8) -> pub u8 {
    let a: Field = <Field as From<u8>>::from(a);
    if (
        if !G_A {
            if !G_A {
                u128::unsafe_from(a)
            } else {
                u128::unsafe_from(a)
            }
        } else {
            u128::unsafe_from(a)
        }
            <= u128::unsafe_from(a)
    ) as bool {
        u8::unsafe_from(--a)
    } else {
        u8::unsafe_from(--a)
    }
}
