---
source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
struct Bar {
    inner: [u8; 3],
}

struct Foo {
    a: u8,
    b: [u8; 3],
    bar: Bar,
}

fn main(pair: (u8, u8), x: [(u8, u8, u8); 2], struct_pair: (Foo, Bar)) -> pub (u8, u8) {
    let mut start_val: u8 = 0_u8;
    for i in 0_u32..2_u32 {
        assert(x[i].0 == start_val);
        assert(x[i].1 == (start_val + 1_u8));
        assert(x[i].2 == (start_val + 2_u8));
        start_val = start_val + 3_u8;
    }
    assert(struct_pair.0.a == 1_u8);
    assert(struct_pair.0.b == [2_u8, 3_u8, 20_u8]);
    assert(struct_pair.0.bar.inner == [100_u8, 101_u8, 102_u8]);
    assert(struct_pair.1.inner == [103_u8, 104_u8, 105_u8]);
    let (u, v): (u8, u8) = if (pair.0 as u32) < 1_u32 {
        (pair.0, pair.0 + 1_u8)
    } else {
        (pair.0 + 1_u8, pair.0)
    };
    assert(u == (pair.0 + 1_u8));
    assert(v == pair.0);
    (u, v)
}
