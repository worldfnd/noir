use std::convert::UnsafeFrom;

struct Holder {
    cell: &mut Field,
}

fn write(h: &mut Holder, v: Field) {
    *h.cell = v;
}

fn main(x: u8, y: u8) -> pub u8 {
    let x: Field = <Field as From<u8>>::from(x);
    let y: Field = <Field as From<u8>>::from(y);
    let mut a: Field = x;
    let cell: &mut Field = &mut a;
    let mut h: Holder = Holder { cell: cell };
    let arr: [(&mut Field, &mut Holder); 1] = [(cell, &mut h)];
    *cell = y;
    write(&mut h, y * 2_Field);
    u8::unsafe_from(*arr[0_u32].0)
}
