global G_A: [Field] = @[];

fn main(a: u32) -> pub [u8; 32] {
    let result: Field = if a == 10_u32 {
        G_A[1_u32 % G_A.len()]
    } else if a == 20_u32 {
        <Field as From<u32>>::from(a)
    } else {
        -1_Field
    };
    result.to_le_bytes()
}
