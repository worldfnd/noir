global G_A: [Field] = @[];

fn main(a: u32) -> pub [u8; 32] {
    if a == 10_u32 {
        G_A[1_u32 % G_A.len()].to_le_bytes()
    } else if a == 20_u32 {
        (a as Field).to_le_bytes()
    } else {
        (0_Field - 1_Field).to_le_bytes()
    }
}
