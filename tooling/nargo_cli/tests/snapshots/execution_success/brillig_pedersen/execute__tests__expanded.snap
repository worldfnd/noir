---
source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
unconstrained fn main(
    x: u8,
    y: u8,
    salt: u8,
    out_x: [u8; 32],
    out_y: [u8; 32],
    out_hash: [u8; 32],
) {
    let res: std::embedded_curve_ops::EmbeddedCurvePoint =
        std::hash::pedersen_commitment_with_separator([x as Field, y as Field], 0_u32);
    assert(res.x == Field::from_le_bytes_checked(out_x));
    assert(res.y == Field::from_le_bytes_checked(out_y));
    let res_hash: Field = std::hash::pedersen_hash_with_separator([x as Field, y as Field], 0_u32);
    assert(res_hash == Field::from_le_bytes_checked(out_hash));
    assert(res_hash != res.x);
    let raw_data: [Field; 2] = [x as Field, y as Field];
    let mut state: Field = 0_Field;
    for i in 0_u32..2_Field as u32 {
        state = (state * 8_Field) + raw_data[i];
    }
    state = state + (salt as Field);
    let hash: std::embedded_curve_ops::EmbeddedCurvePoint =
        std::hash::pedersen_commitment_with_separator([state], 0_u32);
    assert(std::hash::pedersen_commitment_with_separator([43_Field], 0_u32).x == hash.x);
}
