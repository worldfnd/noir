fn main(x: u8) -> pub u8 {
    let arr: [u8; 2] = [1_u8, 2_u8];
    if arr[0_u32] != arr[1_u32] {
        for i in 0_u32..1_u32 {
            assert(i != 2_u32);
        }
    };
    ((x as Field) + safe_inverse(0_Field)) as u8
}

fn safe_inverse(n: Field) -> Field {
    if n == 0_Field {
        0_Field
    } else {
        1_Field / n
    }
}
