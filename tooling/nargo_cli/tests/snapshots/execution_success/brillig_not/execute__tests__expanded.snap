fn main(x: u8, y: u8) {
    // Safety: comment added by `nargo expand`
    unsafe {
        assert(false == not_operator(x != 0_u8));
        assert(true == not_operator(y != 0_u8));
    }
}

unconstrained fn not_operator(x: bool) -> bool {
    !x
}
