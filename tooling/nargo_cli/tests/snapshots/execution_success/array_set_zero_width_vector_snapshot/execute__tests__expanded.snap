use std::convert::UnsafeFrom;

struct Cell {
    a: Field,
    e: [Field; 0],
}

fn main(x: u8, z: u8, idx: u32, j: u32, k: u32, l: u32) -> pub u32 {
    let x: Field = <Field as From<u8>>::from(x);
    let z: Field = <Field as From<u8>>::from(z);
    let mut v: [Cell] = [Cell { a: x, e: [] }, Cell { a: x + 1_Field, e: [] }].as_vector();
    v = v.insert(idx, Cell { a: x + 2_Field, e: [] });
    let mut c: [Cell] = v;
    c[j].e = [];
    v[k].a = z;
    u32::unsafe_from((c[l].a * 100_Field) + v[l].a)
}
