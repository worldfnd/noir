fn main(x: u8, y: u8) {
    let pair: (u8, u8) = (x, y);
    assert(pair.0 == 1_u8);
    assert(pair.1 == 0_u8);
    let (a, b): (Field, Field) = if true {
        (0_Field, 1_Field)
    } else {
        (2_Field, 3_Field)
    };
    assert(a == 0_Field);
    assert(b == 1_Field);
    let (u, v): (u8, u8) = if (x as u32) < 1_u32 {
        (x, x + 1_u8)
    } else {
        (x + 1_u8, x)
    };
    assert(u == (x + 1_u8));
    assert(v == x);
    let mut mutable: ((u8, u8), Field, Field, Field) = ((0_u8, 0_u8), 1_Field, 2_Field, 3_Field);
    mutable.0 = (x, y);
    mutable.2 = 7_Field;
    assert(mutable.0.0 == 1_u8);
    assert(mutable.0.1 == 0_u8);
    assert(mutable.1 == 1_Field);
    assert(mutable.2 == 7_Field);
    assert(mutable.3 == 3_Field);
    let mut (a, b): (Field, Field) = (1_Field, 2_Field);
    b = b * 2_Field;
    a = a + b;
    assert(a == 5_Field);
}
