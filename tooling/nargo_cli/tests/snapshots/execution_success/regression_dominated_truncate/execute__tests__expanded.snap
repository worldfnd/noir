use std::convert::UnsafeFrom;

unconstrained fn helper(cond: bool, x: Field) -> Field {
    if cond {
        <Field as From<u8>>::from(u8::unsafe_from(x))
    } else {
        x.assert_max_bit_size::<8>();
        0_Field
    }
}

fn main(cond: bool, x: pub u16) {
    let x: Field = <Field as From<u16>>::from(x);
    // Safety: comment added by `nargo expand`
    let y: Field = unsafe { helper(cond, x) };
    assert(y != x);
}
