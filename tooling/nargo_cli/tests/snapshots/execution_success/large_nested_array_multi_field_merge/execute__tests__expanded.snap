source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
struct Element<T> {
    a: T,
    b: T,
    c: T,
    d: T,
    e: T,
}

fn main(input: [Element<u32>; 256], condition: bool) {
    let mut arr: [Element<Field>; 256] = input.map(|x: Element<u32>| -> Element<Field> {
        Element::<Field> {
            a: x.a as Field,
            b: x.b as Field,
            c: x.c as Field,
            d: x.d as Field,
            e: x.e as Field,
        }
    });
    for i in 0_u32..256_u32 {
        if condition {
            arr[i].a = arr[i].a + 1_Field;
            arr[i].c = arr[i].c + 2_Field;
            arr[i].e = arr[i].e + 3_Field;
        }
    }
    assert(arr[0_u32].a != 0_Field);
}
