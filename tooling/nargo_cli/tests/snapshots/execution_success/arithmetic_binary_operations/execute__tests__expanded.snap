use std::convert::UnsafeFrom;

fn main(x: u8, y: u8, z: u8) -> pub u8 {
    let x: Field = <Field as From<u8>>::from(x);
    let y: Field = <Field as From<u8>>::from(y);
    let z: Field = <Field as From<u8>>::from(z);
    assert((u8::unsafe_from(y) % 2_u8) == 0_u8);
    let a: Field = x + x;
    let b: Field = a - y;
    let c: Field = b * z;
    let d: Field = c / a;
    u8::unsafe_from(d * a)
}
