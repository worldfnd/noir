global BYTES: [u8; 4] = [102, 7, 111, 111];

global S: str<4> = BYTES.as_str_unchecked();

fn main(x: u8) {
    let x: Field = <Field as From<u8>>::from(x);
    let bytes: [u8; 4] = S.as_bytes();
    assert((<Field as From<u8>>::from(bytes[1_u32]) + x) == 12_Field);
    assert(x == 5_Field);
}
