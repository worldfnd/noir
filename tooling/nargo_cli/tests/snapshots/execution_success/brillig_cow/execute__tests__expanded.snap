---
source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
global ARRAY_SIZE: u32 = 5;

struct ExecutionResult {
    original: [u8; 5],
    modified_once: [u8; 5],
    modified_twice: [u8; 5],
}

impl ExecutionResult {
    fn is_equal(self, other: Self) -> bool {
        ((self.original == other.original) & (self.modified_once == other.modified_once))
            & (self.modified_twice == other.modified_twice)
    }
}

fn modify_in_inlined_constrained(original: [u8; 5], index: u32) -> ExecutionResult {
    let mut modified: [u8; 5] = original;
    modified[index] = 27_u8;
    let modified_once: [u8; 5] = modified;
    modified[index + 1_u32] = 27_u8;
    ExecutionResult { original: original, modified_once: modified_once, modified_twice: modified }
}

unconstrained fn modify_in_unconstrained(original: [u8; 5], index: u32) -> ExecutionResult {
    let mut modified: [u8; 5] = original;
    modified[index] = 27_u8;
    let modified_once: [u8; 5] = modified;
    modified[index + 1_u32] = 27_u8;
    ExecutionResult { original: original, modified_once: modified_once, modified_twice: modified }
}

unconstrained fn main(original: [u8; 5], index: u32, expected_result: ExecutionResult) {
    assert(expected_result.is_equal(modify_in_unconstrained(original, index)));
    assert(expected_result.is_equal(modify_in_inlined_constrained(original, index)));
}
