use std::convert::UnsafeFrom;

fn main(x: u8, y: u8, a: u8, b: u8) {
    let x: Field = <Field as From<u8>>::from(x);
    let y: Field = <Field as From<u8>>::from(y);
    let a: Field = <Field as From<u8>>::from(a);
    let b: Field = <Field as From<u8>>::from(b);
    let x_as_u8: u8 = u8::unsafe_from(x);
    let y_as_u8: u8 = u8::unsafe_from(y);
    assert((x_as_u8 & y_as_u8) == x_as_u8);
    let flag: bool = (x == 0_Field) & (y == 16_Field);
    assert(flag);
    let a_as_u8: u8 = u8::unsafe_from(a);
    let b_as_u8: u8 = u8::unsafe_from(b);
    assert((a_as_u8 & b_as_u8) == a_as_u8);
}
