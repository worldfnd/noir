use std::convert::UnsafeFrom;

fn main(x: u8, y: pub u8) -> pub u16 {
    assert(x != y);
    let mut f: [fn(Field) -> Field; 1] = [my_fun];
    f[0_u32] = my_fun2;
    u16::unsafe_from(f[0_u32](<Field as From<u8>>::from(x)))
}

fn my_fun(x: Field) -> Field {
    x + 1_Field
}

fn my_fun2(x: Field) -> Field {
    x + 2_Field
}
