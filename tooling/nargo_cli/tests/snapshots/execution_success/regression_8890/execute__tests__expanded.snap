fn main(x: u8, y: pub u8) -> pub u16 {
    assert(x != y);
    let mut f: [fn(Field) -> Field; 1] = [my_fun];
    f[0_u32] = my_fun2;
    f[0_u32](x as Field) as u16
}

fn my_fun(x: Field) -> Field {
    x + 1_Field
}

fn my_fun2(x: Field) -> Field {
    x + 2_Field
}
