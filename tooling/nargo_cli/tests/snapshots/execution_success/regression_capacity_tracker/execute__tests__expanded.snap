source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
fn main(expected: pub u8, first: u8, input: [u8; 20]) {
    let mut hasher_vector: [u8] = input.as_vector();
    hasher_vector = hasher_vector.push_front(first);
    assert(hasher_vector[0_u32] == expected);
    if (expected as u32) > 10_u32 {
        hasher_vector[(expected - 10_u8) as u32] = 100_u8;
    } else {
        hasher_vector[expected as u32] = 100_u8;
    };
    assert(hasher_vector[0_u32] == expected);
}
