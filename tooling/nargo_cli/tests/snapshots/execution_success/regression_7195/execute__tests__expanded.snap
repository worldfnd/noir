fn bar(y: Field) {
    assert(y != 0_Field);
}

fn foo(x: Field) {
    // Safety: comment added by `nargo expand`
    let y: Field = unsafe { baz(x) };
    bar(y);
}

unconstrained fn baz(x: Field) -> Field {
    x
}

fn main(x: u8, y: pub u8) {
    // Safety: comment added by `nargo expand`
    let x: Field = unsafe { baz(x as Field) };
    foo(x);
    foo(y as Field);
    assert(x != (y as Field));
}
