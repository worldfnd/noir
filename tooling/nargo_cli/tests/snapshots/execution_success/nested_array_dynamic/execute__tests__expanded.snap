---
source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
struct Bar {
    inner: [u16; 3],
}

struct Foo {
    a: u16,
    b: [u16; 3],
    bar: Bar,
}

struct FooParent {
    array: [Field; 3],
    foos: [Foo; 4],
}

fn main(mut x: [Foo; 4], y: pub u32) {
    assert(x[y - 3_u32].a == 1_u16);
    assert(x[y - 3_u32].b == [2_u16, 3_u16, 20_u16]);
    assert(x[y - 2_u32].a == 4_u16);
    assert(x[y - 2_u32].b == [5_u16, 6_u16, 21_u16]);
    assert(x[y - 1_u32].a == 7_u16);
    assert(x[y - 1_u32].b == [8_u16, 9_u16, 22_u16]);
    assert(x[y].a == 10_u16);
    assert(x[y].b == [11_u16, 12_u16, 23_u16]);
    assert(x[y].bar.inner == [109_u16, 110_u16, 111_u16]);
    if y != 2_u32 {
        x[y].a = 50_u16;
    } else {
        x[y].a = 100_u16;
    };
    assert(x[3_u32].a == 50_u16);
    if y == 2_u32 {
        x[y - 1_u32].b = [50_u16, 51_u16, 52_u16];
    } else {
        x[y - 1_u32].b = [100_u16, 101_u16, 102_u16];
    };
    assert(x[2_u32].b == [100_u16, 101_u16, 102_u16]);
    assert(x[y - 3_u32].bar.inner == [100_u16, 101_u16, 102_u16]);
    assert(x[y - 2_u32].bar.inner == [103_u16, 104_u16, 105_u16]);
    assert(x[y - 1_u32].bar.inner == [106_u16, 107_u16, 108_u16]);
    assert(x[y].bar.inner == [109_u16, 110_u16, 111_u16]);
    let foo_parent_one: FooParent = FooParent { array: [0_Field, 1_Field, 2_Field], foos: x };
    let foo_parent_two: FooParent = FooParent { array: [3_Field, 4_Field, 5_Field], foos: x };
    let mut foo_parents: [FooParent; 2] = [foo_parent_one, foo_parent_two];
    assert(foo_parents[y - 3_u32].foos[y - 3_u32].b == [2_u16, 3_u16, 20_u16]);
    assert(foo_parents[y - 3_u32].foos[y - 2_u32].b == [5_u16, 6_u16, 21_u16]);
    assert(foo_parents[y - 3_u32].foos[y - 1_u32].b == [100_u16, 101_u16, 102_u16]);
    assert(foo_parents[y - 3_u32].foos[y].b == [11_u16, 12_u16, 23_u16]);
    assert(foo_parents[y - 3_u32].foos[y].a == 50_u16);
    assert(foo_parents[1_u32].foos[1_u32].b == [5_u16, 6_u16, 21_u16]);
    if y == 2_u32 {
        foo_parents[y - 2_u32].foos[y - 2_u32].b = [10_u16, 9_u16, 8_u16];
    } else {
        foo_parents[y - 2_u32].foos[y - 2_u32].b = [20_u16, 19_u16, 18_u16];
    };
    assert(foo_parents[1_u32].foos[1_u32].b == [20_u16, 19_u16, 18_u16]);
    assert(foo_parents[1_u32].foos[1_u32].b[2_u32] == 18_u16);
    if y == 3_u32 {
        foo_parents[y - 2_u32].foos[y - 2_u32].b[y - 1_u32] = 5000_u16;
    } else {
        foo_parents[y - 2_u32].foos[y - 2_u32].b[y - 1_u32] = 1000_u16;
    };
    assert(foo_parents[1_u32].foos[1_u32].b[2_u32] == 5000_u16);
    foo_parents[y - 2_u32].foos[y - 3_u32].b = foo_parents[y - 2_u32].foos[y - 2_u32].b;
    assert(foo_parents[1_u32].foos[0_u32].b == [20_u16, 19_u16, 5000_u16]);
}
