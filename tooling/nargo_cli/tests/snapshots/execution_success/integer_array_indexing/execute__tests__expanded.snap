global ARRAY_LEN: u32 = 3;

fn main(arr: [u8; 3], x: u32) -> pub u8 {
    let mut value: Field = arr[ARRAY_LEN - 1_u32] as Field;
    value = value + (arr[0_u32] as Field);
    value = value + (arr[1_u32] as Field);
    (value + (x as Field)) as u8
}
