fn main(x: u8, y: u8, array_input: [[u8; 2]; 2]) {
    assert(array_input[0_u32][0_u32] == x);
    assert(array_input[0_u32][1_u32] == y);
    let arr: [[u8; 2]; 1] = [[3_u8, 3_u8]];
    assert(arr[0_u32] == array_input[1_u32]);
}
