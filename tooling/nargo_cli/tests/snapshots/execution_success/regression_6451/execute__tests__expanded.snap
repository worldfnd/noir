fn main(x: u8) {
    // Safety: comment added by `nargo expand`
    let y: Field = unsafe { empty(x as Field) };
    let mut value: Field = 0_Field;
    let term1: Field = ((x as Field) * (x as Field)) - ((x as Field) * y);
    std::as_witness(term1);
    value = value + term1;
    let term2: Field = ((x as Field) * (x as Field)) - (y * (x as Field));
    value = value + term2;
    value.assert_max_bit_size::<1>();
    // Safety: comment added by `nargo expand`
    let y: Field = unsafe { empty((x as Field) + 1_Field) };
    let z: Field = (y + (x as Field)) + 1_Field;
    let z1: Field = z + y;
    assert((z + z1) != 3_Field);
    let w: Field = (y + (2_Field * (x as Field))) + 3_Field;
    assert((w + z1) != z);
}

unconstrained fn empty(_: Field) -> Field {
    0_Field
}
