struct S {
    a: Field,
    b: [u8; 2],
}

struct InputS {
    a: u8,
    b: [u8; 2],
}

fn main(x: [InputS; 2], i: u32, c: bool, v: u8) -> pub [u8; 2] {
    let x: [S; 2] = x.map(|s: InputS| -> S S { a: <Field as From<u8>>::from(s.a), b: s.b });
    let v: Field = <Field as From<u8>>::from(v);
    let mut s: [S] = x.as_vector();
    s[i] = S { a: v, b: [0_u8, 0_u8] };
    let mut r: [u8; 2] = [0_u8, 0_u8];
    if c { r = s[1_u32].b; };
    r
}
