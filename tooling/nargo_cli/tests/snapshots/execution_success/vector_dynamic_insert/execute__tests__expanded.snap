source: tooling/nargo_cli/tests/execute.rs
expression: expanded_code
---
fn main(x: u32, array: [u8; 5]) {
    insert(x, array);
    insert_dynamic_array(x, array);
}

fn insert(x: u32, array: [u8; 5]) {
    let mut vector: [u8] = array.as_vector();
    assert(x == 5_u32);
    vector = vector.insert(x - 2_u32, 10_u8);
    assert(vector.len() == 6_u32);
    let expected: [u8] = [1_u8, 2_u8, 3_u8, 10_u8, 4_u8, 5_u8].as_vector();
    for i in 0_u32..6_u32 {
        assert(vector[i] == expected[i]);
    }
}

fn insert_dynamic_array(x: u32, array: [u8; 5]) {
    let mut value_to_insert: [u8; 5] = array;
    value_to_insert[x - 1_u32] = 10_u8;
    let mut vector: [[u8; 5]] = [array, array, array].as_vector();
    vector = vector.insert(x - 3_u32, value_to_insert);
    assert(vector.len() == 4_u32);
    let expected: [[u8; 5]] = [
        [1_u8, 2_u8, 3_u8, 4_u8, 5_u8],
        [1_u8, 2_u8, 3_u8, 4_u8, 5_u8],
        [1_u8, 2_u8, 3_u8, 4_u8, 10_u8],
        [1_u8, 2_u8, 3_u8, 4_u8, 5_u8],
    ]
        .as_vector();
    for i in 0_u32..3_u32 {
        for j in 0_u32..5_u32 {
            assert(vector[i][j] == expected[i][j]);
        }
    }
}
